NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadbooster" // Change this 
REDIS_URL=redis://localhost:6379

ACCESS_TOKEN_SECRET=your_super_secret_key_min_32_characters_long
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_min_32_characters_long
REFRESH_TOKEN_EXPIRE=30d

RESEND_API_KEY=your_resend_api_key
APP_URL = http://localhost:3000

CORS_ORIGIN=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Optional — the backend's own public base URL. Defaults to GOOGLE_CALLBACK_URL
# with "/auth/google/callback" stripped off if not set.
API_BASE_URL=http://localhost:3001/api/v1

# Parent Twilio account — used only to provision per-tenant subaccounts.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555555555

# 32-byte key (64 hex chars) used to encrypt OAuth tokens at rest. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters_from_openssl_rand_hex_32

# Separate 32-byte key (64 hex chars) used to encrypt tenant Twilio subaccount
# credentials at rest. Generate with: openssl rand -hex 32
TWILIO_CREDENTIAL_ENCRYPTION_KEY=replace_with_64_hex_characters_from_openssl_rand_hex_32

# Optional
LOG_LEVEL=info
